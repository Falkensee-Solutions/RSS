# Optional: HTTP endpoint that receives the form POST (JSON body).
# If unset, the form falls back to a mailto link.
NEXT_PUBLIC_FORM_ENDPOINT=

# Contact email for fallback mailto and footer.
NEXT_PUBLIC_CONTACT_EMAIL=rssteam@forumdialog.org

# Sanity CMS (public read-only build configuration)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Sanity Studio uses the same values with the SANITY_STUDIO_ prefix.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
